# ========================================
# Care.xyz Environment Variables Template
# ========================================
# Copy this to .env.local and fill in your values

# ========================================
# DATABASE CONFIGURATION
# ========================================
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/care-xyz?retryWrites=true&w=majority

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# NextAuth configuration
NEXTAUTH_SECRET=generate-a-random-32-character-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# JWT Secret for token signing
JWT_SECRET=generate-another-random-32-character-key-here

# Google OAuth (Optional - for Google Login)
GOOGLE_ID=your-google-client-id-from-console.cloud.google.com
GOOGLE_SECRET=your-google-client-secret

# ========================================
# EMAIL CONFIGURATION
# ========================================
# Gmail SMTP settings
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-16-character-app-password-from-gmail
EMAIL_FROM=noreply@care-xyz.com

# ========================================
# STRIPE PAYMENT CONFIGURATION
# ========================================
# Stripe API Keys from dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# ========================================
# API CONFIGURATION
# ========================================
# Application URLs
API_URL=http://localhost:3000/api

# ========================================
# SERVICE CONFIGURATION
# ========================================
# Default service charge per hour (in BDT)
NEXT_PUBLIC_SERVICE_CHARGE=500

# ========================================
# ENVIRONMENT
# ========================================
# NODE_ENV=development
# NODE_ENV=production
